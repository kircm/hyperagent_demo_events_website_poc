# Gather — local configuration.
#
#   cp .env.example .env
#
# `npm start` and `npm run seed` load .env automatically (Node's
# --env-file-if-exists, no dotenv dependency). Real environment variables
# always win over this file. .env is gitignored — never commit it.
#
# Every value is optional. With nothing set, Gather runs free events only and
# prints emails to the console instead of sending them.

# ------------------------------------------------------------------ server
PORT=8787
GATHER_DB=./gather.db
# Where browsers reach the app. Stripe redirect URLs and links inside emails
# are built from this, so set it whenever you run behind a proxy or tunnel.
GATHER_PUBLIC_URL=http://localhost:8787
# How often the email outbox worker runs, in milliseconds.
# GATHER_MAILER_INTERVAL_MS=15000

# ------------------------------------------------------------------ stripe
# Test-mode secret key (sk_test_...). Blank disables paid events.
STRIPE_SECRET_KEY=
# Printed by: stripe listen --forward-to localhost:8787/api/stripe/webhook
# Blank means payments can start but will never confirm.
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------- email
# Provider credential. Blank logs every email to the console instead.
EMAIL_API_KEY=
# resend (the default whenever a key is set), postmark, or console.
# EMAIL_PROVIDER=resend
# Must be an address your provider has verified for sending.
EMAIL_FROM="Gather <hello@yourdomain.com>"
# EMAIL_REPLY_TO=
# Postmark only: which message stream to send through.
# EMAIL_STREAM=outbound
